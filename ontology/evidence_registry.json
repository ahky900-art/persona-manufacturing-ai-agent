  "node_classes": [
    {
      "class": "PersonaRole",
      "basis": "Hugging Face synthetic persona occupational fields; project-defined taxonomy",
      "not_for": [
        "individual accident probability",
        "personality inference",
        "worker competency rating"
      ]
    },
    {
      "class": "AccidentRecord",
      "basis": "KOSHA original record; retain original identifiers and columns"
    },
    {
      "class": "OfficialAccidentType",
      "basis": "exact source field/code from current KOSHA schema; never infer code"
    },
    {
      "class": "AnalyticalHazardTag",
      "basis": "project multi-label analysis mapping from accident narrative; not official classification"
    },
    {
      "class": "WorkActivity",
      "basis": "explicit activity in accident narrative, permit, or task record"
    },
    {
      "class": "Equipment",
      "basis": "explicit equipment in accident narrative, equipment master, or validated plant record"
    },
    {
      "class": "HazardousCondition",
      "basis": "regulation, risk assessment, incident investigation, or approved procedure"
    },
    {
      "class": "DamageMechanism",
      "basis": "peer-reviewed literature and material/operating conditions"
    },
    {
      "class": "DamageMode",
      "basis": "inspection, failure analysis, maintenance record, or literature"
    },
    {
      "class": "ObservableSignal",
      "basis": "sensor specification, equipment design, inspection method, or validated literature"
    },
    {
      "class": "Threshold",
      "basis": "law/regulation, OEM/design, approved site limit, or validated statistical model"
    }
  ],
